<Window x:Class="KeyBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KeyBridge" Width="1140" Height="800" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,1,0" Padding="22,28,18,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,26">
          <TextBlock Text="KeyBridge" FontSize="{DynamicResource BrandFontSize}" FontWeight="Bold"/>
          <TextBlock Text="Your shortcuts, on Windows." TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="LOCAL BY DESIGN" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="No account. No input history." TextWrapping="Wrap" Margin="0,8,0,12"/>
          <Button Content="_Pause now" Click="PauseClick" HorizontalAlignment="Stretch" AutomationProperties.Name="Pause all shortcut mapping"/>
          <Button Content="E_xit KeyBridge" Click="ExitClick" HorizontalAlignment="Stretch"/>
        </StackPanel>
        <ListBox x:Name="Navigation" SelectionChanged="NavigationChanged" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="Navigation">
          <ListBoxItem Content="Home" Padding="12"/><ListBoxItem Content="Shortcuts" Padding="12"/>
          <ListBoxItem Content="Applications" Padding="12"/><ListBoxItem Content="Input methods" Padding="12"/>
          <ListBoxItem Content="Try it" Padding="12"/><ListBoxItem Content="Settings" Padding="12"/>
          <ListBoxItem Content="About &amp; privacy" Padding="12"/>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,28,32,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="PageTitle" Text="Welcome to KeyBridge" FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" Padding="14" Margin="0,18,0,22">
        <TextBlock x:Name="StatusText" Text="Paused • Setup is required before mapping can start." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Margin="0,0,12,12"/>
      </ScrollViewer>
      <TextBlock Grid.Row="3" x:Name="Feedback" Margin="0,14,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
  </Grid>
</Window>
